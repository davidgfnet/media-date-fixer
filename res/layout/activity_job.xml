<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/header" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">

            <LinearLayout android:id="@+id/progress_card" style="@style/Card" android:visibility="gone">
                <TextView android:id="@+id/progress_title" style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <ProgressBar android:id="@+id/progress" style="@android:style/Widget.Material.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="20dp" android:max="1000" android:progressDrawable="@drawable/progress" />
                <TextView android:id="@+id/progress_count" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/on_surface" />
                <TextView android:id="@+id/progress_file" style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="middle" android:singleLine="true" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="end" android:orientation="horizontal">
                    <Button android:id="@+id/cancel_button" style="@style/Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cancel" />
                    <Button android:id="@+id/pause_button" style="@style/Button.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/pause" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/result_card" style="@style/Card" android:visibility="gone">
                <TextView android:id="@+id/result_title" style="@style/Text.Display" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/result_summary" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                <LinearLayout android:id="@+id/result_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />
                <TextView android:id="@+id/result_note" style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
            </LinearLayout>

            <LinearLayout android:id="@+id/problems_card" style="@style/Card" android:visibility="gone">
                <TextView style="@style/Text.Subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/problems" />
                <LinearLayout android:id="@+id/problems" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout android:id="@+id/interrupted_card" style="@style/Card" android:visibility="gone">
                <TextView style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/interrupted_title" />
                <TextView android:id="@+id/interrupted_body" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/job_bottom" style="@style/BottomBar" android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/undo_button" style="@style/Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:text="@string/undo" />
        <Button android:id="@+id/done_button" style="@style/Button.Primary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/done" />
    </LinearLayout>
</LinearLayout>
