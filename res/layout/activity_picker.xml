<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/header" />
    <TextView android:id="@+id/picker_path" style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="start" android:paddingStart="20dp" android:paddingEnd="20dp" android:singleLine="true" />
    <CheckBox android:id="@+id/picker_this" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginTop="8dp" android:layout_marginEnd="12dp" android:minHeight="48dp" android:paddingStart="12dp" android:text="@string/picker_this" android:textColor="@color/on_surface" android:textSize="15sp" />
    <ListView android:id="@+id/picker_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:divider="@null" android:paddingStart="8dp" android:paddingEnd="8dp" />
    <TextView android:id="@+id/picker_empty" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="@string/picker_empty" android:visibility="gone" />
    <LinearLayout style="@style/BottomBar" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/picker_count" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <Button android:id="@+id/picker_done" style="@style/Button.Primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/done" />
    </LinearLayout>
</LinearLayout>
