<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/header" />
    <ScrollView android:id="@+id/adv_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp">

            <LinearLayout style="@style/Card">
                <TextView style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sec_folders" />
                <LinearLayout android:id="@+id/folder_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
                <TextView android:id="@+id/folder_empty" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/no_folders" />
                <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/suggestions" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:id="@+id/suggestion_chips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>
                <Button android:id="@+id/add_folder" style="@style/Button.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/browse" />
                <Switch android:id="@+id/recursive" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/recursive" />
            </LinearLayout>

            <LinearLayout style="@style/Card">
                <TextView style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sec_sources" />
                <TextView style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/sources_hint" />
                <LinearLayout android:id="@+id/source_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
                <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/filename_patterns" />
                <LinearLayout android:id="@+id/preset_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <EditText android:id="@+id/custom_regex" style="@style/Input" android:fontFamily="monospace" android:hint="@string/custom_regex_hint" android:inputType="text|textNoSuggestions" android:textSize="13sp" />
                <TextView android:id="@+id/regex_status" style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/custom_regex_help" />
                <EditText android:id="@+id/test_name" style="@style/Input" android:hint="@string/test_hint" android:inputType="text|textNoSuggestions" />
                <TextView android:id="@+id/test_result" style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:visibility="gone" />
                <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/timezone" />
                <Button android:id="@+id/zone_button" style="@style/Button.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/Card">
                <TextView style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sec_filters" />
                <EditText android:id="@+id/name_filter" style="@style/Input" android:layout_marginTop="12dp" android:fontFamily="monospace" android:hint="@string/name_filter_hint" android:inputType="text|textNoSuggestions" android:textSize="13sp" />
                <EditText android:id="@+id/ext_filter" style="@style/Input" android:hint="@string/ext_filter_hint" android:inputType="text|textNoSuggestions" />
                <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/date_range" />
                <LinearLayout android:id="@+id/range_chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="horizontal" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/date_from" style="@style/Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    <Button android:id="@+id/date_to" style="@style/Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    <Button android:id="@+id/date_clear" style="@style/Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/clear" />
                </LinearLayout>
                <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/size_range" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <EditText android:id="@+id/size_min" style="@style/Input" android:layout_width="0dp" android:layout_marginTop="0dp" android:layout_weight="1" android:hint="@string/min" android:inputType="numberDecimal" />
                    <EditText android:id="@+id/size_max" style="@style/Input" android:layout_width="0dp" android:layout_marginStart="8dp" android:layout_marginTop="0dp" android:layout_weight="1" android:hint="@string/max" android:inputType="numberDecimal" />
                </LinearLayout>
                <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/exif_filter" />
                <LinearLayout android:id="@+id/exif_chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
                <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mismatch_filter" />
                <LinearLayout android:id="@+id/mismatch_chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
                <LinearLayout android:id="@+id/tolerance_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tolerance" />
                    <LinearLayout android:id="@+id/tolerance_chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
                    <TextView style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/tolerance_help" />
                    <TextView android:id="@+id/tolerance_warning" style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/tolerance_warning" android:textColor="@color/warning" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card">
                <TextView style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sec_actions" />
                <Switch android:id="@+id/act_mtime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/act_mtime" />
                <Switch android:id="@+id/act_exif" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/act_exif" />
                <TextView style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/act_exif_help" />
                <Switch android:id="@+id/act_mp4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/act_mp4" />
                <TextView style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/act_mp4_help" />
            </LinearLayout>

            <LinearLayout style="@style/Card">
                <LinearLayout android:id="@+id/expert_toggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackground" android:gravity="center_vertical" android:minHeight="40dp" android:orientation="horizontal">
                    <TextView style="@style/Text.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/sec_expert" />
                    <TextView android:id="@+id/expert_state" style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:text="@string/show" />
                </LinearLayout>
                <LinearLayout android:id="@+id/expert" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/exif_tags" />
                    <TextView style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/exif_tags_help" />
                    <LinearLayout android:id="@+id/exif_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card">
                <TextView style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sec_presets" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <Button android:id="@+id/save_preset" style="@style/Button.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/save_preset" />
                    <Button android:id="@+id/load_preset" style="@style/Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/load_preset" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout style="@style/BottomBar">
        <Button android:id="@+id/scan" style="@style/Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/scan_preview" />
    </LinearLayout>
</LinearLayout>
