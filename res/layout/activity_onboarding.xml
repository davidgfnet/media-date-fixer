<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <ImageView android:layout_width="72dp" android:layout_height="72dp" android:layout_marginTop="32dp" android:background="@drawable/bg_icon_circle" android:importantForAccessibility="no" android:padding="18dp" android:src="@drawable/ic_folder" android:tint="@color/on_accent_container" />
            <TextView android:id="@+id/perm_title" style="@style/Text.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/perm_title" />
            <TextView style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/perm_body" />
            <LinearLayout style="@style/Card" android:layout_marginTop="24dp">
                <TextView style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/perm_point1" android:textColor="@color/on_surface" />
                <TextView style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/perm_point2" android:textColor="@color/on_surface" />
                <TextView style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/perm_point3" android:textColor="@color/on_surface" />
            </LinearLayout>
            <TextView android:id="@+id/perm_more" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/perm_more" android:textColor="@color/on_surface" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout style="@style/BottomBar">
        <Button android:id="@+id/perm_grant" style="@style/Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/perm_grant" />
        <Button android:id="@+id/perm_exit" style="@style/Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/exit" />
    </LinearLayout>
</LinearLayout>
