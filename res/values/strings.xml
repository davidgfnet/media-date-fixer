    <!-- Onboarding -->
    <string name="perm_title">Allow access to all files</string>
    <string name="perm_body">To change a file\'s modification date Android requires direct file access. The system\'s file picker cannot do that, so this app needs the “All files access” permission.</string>
    <string name="perm_point1">• Only the folders you scan are touched, and only the dates.</string>
    <string name="perm_point2">• Nothing changes until you review a preview and tap Apply.</string>
    <string name="perm_point3">• The app has no internet permission: nothing leaves your device.</string>
    <string name="perm_more_title">Access is still needed</string>
    <string name="perm_more">Without this permission the app cannot work at all. On the next screen, find “Media Date Fixer” and turn on “Allow access to manage all files”. You can revoke it any time in Settings → Apps → Special app access.</string>
    <string name="perm_grant">Grant access</string>
    <string name="perm_again">Open settings again</string>
