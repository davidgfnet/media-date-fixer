    <string name="exif_tags">EXIF date tags to write</string>
    <string name="exif_tags_help">Used when “Write EXIF date” is on. Each tag gets its matching OffsetTime tag. Undo restores exactly the tags that were written.</string>
    <string name="exif_tag_original">DateTimeOriginal: “date taken”. Android’s media index and most galleries use this one.</string>
    <string name="exif_tag_digitized">DateTimeDigitized: when the file was digitized. Hardly any app reads it.</string>
    <string name="exif_tag_modified">DateTime: “file changed”. Ignored by Android’s media index; a few desktop tools read it.</string>
    <string name="err_no_exif_tags">Pick at least one EXIF tag under Expert, or turn off writing EXIF.</string>
    <string name="act_mp4">Write video creation time</string>
    <string name="act_mp4_help">MP4, MOV, 3GP, M4A. Patched in place; the file size never changes.</string>
