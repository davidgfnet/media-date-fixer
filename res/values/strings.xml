    <!-- Home -->
    <string name="home_subtitle">Restore the real dates of your photos and videos after a backup restore or transfer.</string>
    <string name="wa_title">WhatsApp media</string>
    <string name="wa_body">Sets each file\'s date from its name, e.g. IMG-20230115-WA0007 → 15 Jan 2023. If it spots a restore or copy, you pick it and only those files are fixed.</string>
    <string name="wa_found">Folder: %1$s</string>
    <string name="wa_not_found">No WhatsApp media folder found on this device.</string>
