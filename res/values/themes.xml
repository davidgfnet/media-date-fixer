<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.AppTheme" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="Base.Dialog" parent="android:Theme.Material.Light.Dialog.Alert" />

    <style name="AppTheme" parent="Base.AppTheme">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
        <item name="android:textColorHint">@color/on_surface_variant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:alertDialogTheme">@style/DialogTheme</item>
        <item name="android:datePickerDialogTheme">@style/DatePickerTheme</item>
        <item name="android:switchStyle">@style/Widget.Switch</item>
    </style>

    <style name="DialogTheme" parent="Base.Dialog">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorBackground">@color/card</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
    </style>

    <!-- Wheels instead of the month calendar: year and month are one flick away. -->
    <style name="DatePickerTheme" parent="DialogTheme">
        <item name="android:datePickerStyle">@style/Widget.DatePicker</item>
    </style>

    <style name="Widget.DatePicker" parent="android:Widget.Material.DatePicker">
        <item name="android:datePickerMode">spinner</item>
        <item name="android:calendarViewShown">false</item>
    </style>
</resources>
